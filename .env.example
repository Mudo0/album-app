# Copiá este archivo a .env y completá los valores.
# El archivo .env está gitignoreado: nunca lo commitees.
#
# Webhook del canal #changelog — lo usa scripts/discord.js cuando hacés npm run push.
# OJO: el CI (GitHub Actions) usa OTRO webhook (canal #release) que vive en
# GitHub Secrets con el nombre DISCORD_WEBHOOK_RELEASE. Son canales distintos.
DISCORD_WEBHOOK_CHANGELOG=tu_webhook_changelog_aca
